---
import PlantillaPrincipal from "@/layouts/PlantillaPrincipal.astro";
import TituloSeccion from "@/components/ui/TituloSeccion.astro";
import Boton from "@/components/ui/Boton.astro";
import TarjetaProducto from "@/components/producto/TarjetaProducto.astro";
import Icono from "@/components/ui/Icono";
import {
  imagenHero,
  imagenesCategorias,
  obtenerProductosDestacados,
  obtenerProductosRecientes,
} from "@/data/productos";
import type { Genero } from "@/types/producto";

const productosDestacados = obtenerProductosDestacados();
const productosRecientes = obtenerProductosRecientes();
const categorias: Genero[] = ["Hombre", "Mujer", "Unisex"];
---

<PlantillaPrincipal
  titulo="Maison des Parfums | Alta Perfumería en Perú"
  descripcion="Descubre aromas que trascienden el tiempo. Selección de perfumes originales para hombre, mujer y unisex con atención y pedidos por WhatsApp."
>
  <main>
    <!-- Sección Hero Principal -->
    <section class="hero">
      <img
        src={imagenHero}
        alt="Perfume de lujo en una composición editorial oscura"
        loading="eager"
      />
      <div class="hero-shade"></div>
      <div class="hero-content">
        <p class="eyebrow">Fragancias originales · Curaduría excepcional</p>
        <h1>
          Encuentra una fragancia<br />que hable por ti
        </h1>
        <p>
          Descubre aromas que trascienden el tiempo y convierten tu esencia en una firma inolvidable.
        </p>
        <Boton enlace="/perfumes">
          Explorar perfumes <Icono name="arrow" />
        </Boton>
      </div>
      <div class="hero-index">
        <span>01</span>
        <i></i>
        <span>03</span>
      </div>
    </section>

    <!-- Sección de Categorías -->
    <section class="category-section">
      <TituloSeccion
        antetitulo="Encuentra tu esencia"
        titulo="Una fragancia para cada historia"
        descripcion="Colecciones elegidas para acompañar tu estilo, tu energía y cada uno de tus momentos."
      />
      <div class="category-grid">
        {
          categorias.map((genero) => (
            <a
              class="category-card"
              href={`/perfumes?genero=${genero}`}
            >
              <img
                src={imagenesCategorias[genero]}
                alt={`Perfumes para ${genero.toLowerCase()}`}
                loading="lazy"
              />
              <span>
                <small>Colección</small>
                <strong>{genero}</strong>
                <i>
                  Descubrir <Icono name="arrow" size={16} />
                </i>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Sección de Productos Destacados -->
    <section class="products-section">
      <div class="section-heading-row">
        <TituloSeccion
          antetitulo="Selección Maison"
          titulo="Fragancias destacadas"
        />
        <a href="/perfumes">
          Ver toda la colección <Icono name="arrow" />
        </a>
      </div>
      <div class="product-grid">
        {productosDestacados.map((producto) => <TarjetaProducto producto={producto} />)}
      </div>
    </section>

    <!-- Banner Promocional -->
    <section class="promo">
      <div class="promo-copy">
        <p>El arte de elegir bien</p>
        <h2>
          Tu aroma habla<br />antes que tú
        </h2>
        <span>
          Recibe asesoría personalizada y encuentra esa fragancia que realmente se siente tuya.
        </span>
        <Boton enlace="/contacto" variante="borde">
          Hablar con un asesor <Icono name="arrow" />
        </Boton>
      </div>
      <div class="promo-image">
        <img
          src={imagenesCategorias.Unisex}
          alt="Selección de perfumería nicho"
          loading="lazy"
        />
      </div>
    </section>

    <!-- Sección de Nuevos Ingresos -->
    <section class="products-section new-section">
      <div class="section-heading-row">
        <TituloSeccion
          antetitulo="Recién llegados"
          titulo="Nuevos ingresos"
        />
        <a href="/perfumes">
          Ver novedades <Icono name="arrow" />
        </a>
      </div>
      <div class="product-grid four">
        {productosRecientes.map((producto) => <TarjetaProducto producto={producto} />)}
      </div>
    </section>

    <!-- Sección de Beneficios -->
    <section class="benefits">
      <article>
        <span>01</span>
        <h3>Atención personalizada</h3>
        <p>Te escuchamos para recomendarte una fragancia según tu estilo y ocasión.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Compra por WhatsApp</h3>
        <p>Coordina tu pedido de forma directa, cercana y completamente segura.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Curaduría experta</h3>
        <p>Una selección de casas icónicas y perfumes con carácter excepcional.</p>
      </article>
    </section>

    <!-- Sección Historia de Marca -->
    <section class="brand-story">
      <div class="story-monogram">M</div>
      <div>
        <p class="eyebrow">Nuestra maison</p>
        <h2>
          El perfume como<br />forma de expresión
        </h2>
      </div>
      <div>
        <p>
          Creemos que una fragancia no solo se lleva: se recuerda. En Maison des Parfums reunimos aromas con identidad para ayudarte a encontrar aquel que cuente tu historia.
        </p>
        <a href="/nosotros" class="btn btn-outline" style="border-color: var(--gold); color: var(--gold-light);">
          Conoce nuestra historia <Icono name="arrow" />
        </a>
      </div>
    </section>
  </main>
</PlantillaPrincipal>
