---
import Layout from "@/layouts/Layout.astro";
import SectionTitle from "@/components/ui/SectionTitle.astro";
import Button from "@/components/ui/Button.astro";
import ProductCard from "@/components/product/ProductCard.astro";
import Icon from "@/components/ui/Icon";
import HeroCrossfadeCarousel from "@/components/home/HeroCrossfadeCarousel";
import { categoryImages } from "@/data/products";
import { obtenerProductosTienda, obtenerBannersPorUbicacion } from "@/lib/db";
import type { BannerSlide } from "@/types/database";
import type { Gender } from "@/types/product";

export const prerender = false;

const db = Astro.locals.runtime?.env?.DB;
const allProducts = await obtenerProductosTienda(db);

// Banners dinámicos de la base de datos con respaldo luxury por defecto
const bannersDb = db ? await obtenerBannersPorUbicacion(db, "hero_home") : [];
const defaultHeroSlides: BannerSlide[] = [
  {
    id: 1,
    ubicacion: "hero_home",
    titulo: "Encuentra una fragancia que hable por ti",
    subtitulo: "Fragancias originales · Selección exclusiva",
    descripcion: "Descubre aromas que trascienden el tiempo y convierten tu esencia en una firma inolvidable.",
    texto_boton: "Explorar perfumes",
    enlace_url: "/perfumes",
    imagen_desktop: "https://images.unsplash.com/photo-1594036436267-2750a8ab2ae2?auto=format&fit=crop&w=1800&q=90",
    imagen_mobile: "https://images.unsplash.com/photo-1594036436267-2750a8ab2ae2?auto=format&fit=crop&w=900&q=85",
    orden: 0,
  },
  {
    id: 2,
    ubicacion: "hero_home",
    titulo: "El arte de la distinción olfativa",
    subtitulo: "Casas de autor y alta perfumería europea",
    descripcion: "Descubre aromas que trascienden el tiempo y convierten tu esencia en una firma inolvidable.",
    texto_boton: "Ver Novedades",
    enlace_url: "/perfumes",
    imagen_desktop: "https://images.unsplash.com/photo-1622618991746-fe6004db3a47?auto=format&fit=crop&w=1800&q=90",
    imagen_mobile: "https://images.unsplash.com/photo-1622618991746-fe6004db3a47?auto=format&fit=crop&w=900&q=85",
    orden: 1,
  },
  {
    id: 3,
    ubicacion: "hero_home",
    titulo: "Asesoría cercana y personalizada",
    subtitulo: "Descubre notas creadas a la medida de tu estilo",
    descripcion: "Atención boutique guiada por expertos para elegir tu firma olfativa ideal.",
    texto_boton: "Hablar con un asesor",
    enlace_url: "/contacto",
    imagen_desktop: "https://images.unsplash.com/photo-1705936118918-870095881e61?auto=format&fit=crop&w=1800&q=90",
    imagen_mobile: "https://images.unsplash.com/photo-1705936118918-870095881e61?auto=format&fit=crop&w=900&q=85",
    orden: 2,
  },
];

const heroSlides = bannersDb && bannersDb.length > 0 ? bannersDb : defaultHeroSlides;

// Selección Híbrida Inteligente para la portada:
// 1. Productos ordenados por último ingreso (más recientes primero)
const latestProducts = [...allProducts].sort((a, b) => {
  if (a.createdAt && b.createdAt) {
    return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();
  }
  return b.id - a.id;
});

// 2. Priorizar los perfumes expresamente marcados como destacados en el gestor
const explicitlyFeatured = latestProducts.filter((p) => p.featured);

const featuredSet = new Set<number>();
const featuredProducts: typeof allProducts = [];

for (const p of explicitlyFeatured) {
  if (featuredProducts.length < 5) {
    featuredProducts.push(p);
    featuredSet.add(p.id);
  }
}

// 3. Si faltan cupos para completar 5, rellenar automáticamente con los últimos ingresos
for (const p of latestProducts) {
  if (featuredProducts.length >= 5) break;
  if (!featuredSet.has(p.id)) {
    featuredProducts.push(p);
    featuredSet.add(p.id);
  }
}

// 4. Sección "Nuevos ingresos" (4 perfumes más recientes, evitando repetir los ya destacados)
const recentCandidates = latestProducts.filter((p) => !featuredSet.has(p.id));
const recentProducts = recentCandidates.length >= 4
  ? recentCandidates.slice(0, 4)
  : latestProducts.slice(0, 4);

const categories: Gender[] = ["Hombre", "Mujer", "Unisex"];

const commercialCategories = [
  {
    id: "disenador",
    index: "01",
    badge: "Tendencia & Estilo",
    tagline: "Grandes Firmas",
    title: "Diseñador",
    description: "Chanel, Dior, Tom Ford & clásicos atemporales de la moda global.",
    image: "/assets/categories/categoria-disenador.jpg",
    link: "/perfumes?tipo=disenador",
  },
  {
    id: "arabes",
    index: "02",
    badge: "Larga Fijación",
    tagline: "Tradición y Fijación",
    title: "Árabes",
    description: "Oud majestuoso, aceites attar concentrados & estela legendaria infinita.",
    image: "/assets/categories/categoria-arabes.jpg",
    link: "/perfumes?tipo=arabe",
  },
  {
    id: "nichos",
    index: "03",
    badge: "Exclusividad",
    tagline: "Perfumería de Autor",
    title: "Nichos",
    description: "Fórmulas raras, botánica selecta, acordes experimentales y piezas únicas.",
    image: "/assets/categories/categoria-nichos.jpg",
    link: "/perfumes?tipo=nicho",
  },
  {
    id: "decants",
    index: "04",
    badge: "Prueba en Piel",
    tagline: "Muestras y Viajes",
    title: "Decants",
    description: "Atomizadores de 3ml - 5ml - 10ml para catar en piel antes de invertir.",
    image: "/assets/categories/categoria-decants.jpg",
    link: "/perfumes?formato=decant",
  },
];

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Maison des Parfums",
  "url": "https://maison.pe",
  "potentialAction": {
    "@type": "SearchAction",
    "target": "https://maison.pe/perfumes?q={search_term_string}",
    "query-input": "required name=search_term_string"
  }
};
---

<Layout
  title="Maison des Parfums | Alta Perfumería en Perú"
  description="Descubre aromas que trascienden el tiempo. Selección de perfumes originales para hombre, mujer y unisex con atención y pedidos por WhatsApp."
>
  <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} slot="head" />

  <main>
    <!-- Carrusel Hero Editorial (Opción A: Luxury Crossfade) -->
    <HeroCrossfadeCarousel client:load slides={heroSlides} />

    <!-- Barra de Pilares de Servicio y Confianza -->
    <section class="trust-bar-section" aria-label="Pilares y servicios de Maison des Parfums">
      <div class="trust-bar-container">
        <a href="/contacto" class="trust-bar-item">
          <div class="trust-bar-icon">
            <Icon name="mapPin" size={20} />
          </div>
          <div class="trust-bar-text">
            <strong>Visita nuestro espacio</strong>
            <span>Sede oficial en Tacna · Atención presencial</span>
          </div>
        </a>

        <div class="trust-bar-divider" aria-hidden="true" />

        <a href="/envios" class="trust-bar-item">
          <div class="trust-bar-icon">
            <Icon name="truck" size={20} />
          </div>
          <div class="trust-bar-text">
            <strong>Envíos a todo el Perú</strong>
            <span>Despachos seguros vía Shalom y Olva</span>
          </div>
        </a>

        <div class="trust-bar-divider" aria-hidden="true" />

        <a href="/contacto" class="trust-bar-item">
          <div class="trust-bar-icon">
            <Icon name="whatsapp" size={18} />
          </div>
          <div class="trust-bar-text">
            <strong>Asesoría personalizada</strong>
            <span>Resolvemos tus dudas por WhatsApp</span>
          </div>
        </a>

        <div class="trust-bar-divider" aria-hidden="true" />

        <a href="/envios" class="trust-bar-item">
          <div class="trust-bar-icon">
            <Icon name="creditCard" size={20} />
          </div>
          <div class="trust-bar-text">
            <strong>Pagos y garantía segura</strong>
            <span>Yape, Plin y transferencias directas</span>
          </div>
        </a>
      </div>
    </section>

    <!-- Categories Section -->
    <section class="category-section">
      <SectionTitle
        eyebrow="Encuentra tu esencia"
        title="Una fragancia para cada historia"
        copy="Colecciones elegidas para acompañar tu estilo, tu energía y cada uno de tus momentos."
      />
      <div class="category-grid">
        {
          categories.map((gender) => (
            <a class="category-card" href={`/perfumes?genero=${gender}`}>
              <img
                src={categoryImages[gender]}
                alt={
                  gender.toLowerCase() === "unisex"
                    ? "Perfumes Unisex"
                    : `Perfumes para ${gender.toLowerCase()}`
                }
                loading="lazy"
              />
              <span>
                <small>Colección</small>
                <strong>{gender}</strong>
                <i>
                  Descubrir <Icon name="arrow" size={16} />
                </i>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Featured Products Section (visible cuando existan productos en catálogo) -->
    {featuredProducts.length > 0 && (
      <section class="products-section">
        <div class="section-heading-row">
          <SectionTitle
            eyebrow="Selección Maison"
            title="Fragancias destacadas"
          />
          <a href="/perfumes" class="section-link">Ver toda la colección <Icon name="arrow" size={16} /></a>
        </div>
        <div class="product-grid">
          {featuredProducts.map((product) => <ProductCard product={product} />)}
        </div>
      </section>
    )}

    <!-- Commercial Categories Section (Líneas comerciales ultralujo) -->
    <section
      class="commercial-categories-section linen-pattern"
      data-purpose="commercial-categories-showcase"
      aria-label="Líneas comerciales de perfumería"
    >
      <div class="commercial-categories-container">
        <!-- Header editorial -->
        <header class="commercial-header">
          <span class="commercial-eyebrow">Categorías Comerciales</span>
          <h2 class="commercial-title">Un universo de matices</h2>
          <p class="commercial-copy">
            Cuatro expresiones de la alta perfumería: desde icónicas casas de moda internacionales
            hasta creaciones de autor, acordes orientales y decants para descubrir.
          </p>
        </header>

        <!-- Grid de 4 Tarjetas de Ultralujo -->
        <div class="commercial-grid" data-purpose="categories-grid">
          {
            commercialCategories.map((cat) => (
              <a
                href={cat.link}
                class="commercial-card group"
                data-purpose={`category-card-${cat.id}`}
                aria-label={`Explorar categoría ${cat.title}`}
              >
                <!-- Imagen de fondo con zoom fluido -->
                <img
                  src={cat.image}
                  alt={`Línea ${cat.title} - Maison des Parfums`}
                  loading="lazy"
                  decoding="async"
                  class="commercial-card-img"
                />

                <!-- Degradado editorial profundo -->
                <div class="commercial-card-overlay" />

                <!-- Parte superior: Índice & Badge Glassmorphism -->
                <div class="commercial-card-top">
                  <span class="commercial-card-index">{cat.index}</span>
                  <span class="commercial-card-badge">{cat.badge}</span>
                </div>

                <!-- Contenido inferior -->
                <div class="commercial-card-bottom">
                  <p class="commercial-card-tagline">
                    <span class="commercial-card-dot" />
                    {cat.tagline}
                  </p>
                  <h3 class="commercial-card-heading">{cat.title}</h3>
                  <p class="commercial-card-desc">{cat.description}</p>
                  <div class="commercial-card-cta">
                    <span>Explorar Colección</span>
                    <span class="commercial-card-arrow">
                      <Icon name="arrow" size={14} />
                    </span>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Promo Banner Section -->
    <section class="promo">
      <div class="promo-copy">
        <p>El arte de elegir bien</p>
        <h2>
          Tu aroma habla<br />antes que tú
        </h2>
        <span>
          Recibe asesoría personalizada y encuentra esa fragancia que realmente
          se siente tuya.
        </span>
        <Button href="/contacto" variant="outline">
          Hablar con un asesor <Icon name="arrow" />
        </Button>
      </div>
      <div class="promo-image">
        <img
          src={categoryImages.Unisex}
          alt="Selección de perfumería nicho"
          loading="lazy"
        />
      </div>
    </section>

    <!-- New Arrivals Section -->
    <section class="products-section new-section">
      <div class="section-heading-row">
        <SectionTitle eyebrow="Recién llegados" title="Nuevos ingresos" />
        <a href="/perfumes" class="section-link">Ver novedades <Icon name="arrow" size={16} /></a>
      </div>
      <div class="product-grid four">
        {recentProducts.map((product) => <ProductCard product={product} />)}
      </div>
    </section>

    <!-- Benefits Section -->
    <section class="benefits">
      <article>
        <span>01</span>
        <h3>Atención personalizada</h3>
        <p>
          Te escuchamos para recomendarte una fragancia según tu estilo y
          ocasión.
        </p>
      </article>
      <article>
        <span>02</span>
        <h3>Compra por WhatsApp</h3>
        <p>
          Coordina tu pedido de forma directa, cercana y completamente segura.
        </p>
      </article>
      <article>
        <span>03</span>
        <h3>Selección experta</h3>
        <p>
          Una selección de casas icónicas y perfumes con carácter excepcional.
        </p>
      </article>
    </section>

    <!-- Brand Story Section -->
    <section class="brand-story">
      <div class="story-monogram">M</div>
      <div>
        <p class="eyebrow">Nuestra maison</p>
        <h2>
          El perfume como<br />forma de expresión
        </h2>
      </div>
      <div>
        <p>
          Creemos que una fragancia no solo se lleva: se recuerda. En Maison des
          Parfums reunimos aromas con identidad para ayudarte a encontrar aquel
          que cuente tu historia.
        </p>
        <a
          href="/nosotros"
          class="btn btn-outline"
          style="border-color: var(--gold); color: var(--gold-light);"
        >
          Conoce nuestra historia <Icon name="arrow" />
        </a>
      </div>
    </section>
  </main>
</Layout>
