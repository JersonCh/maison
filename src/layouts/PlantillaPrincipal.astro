---
import BarraAnuncio from "@/components/layout/BarraAnuncio.astro";
import Cabecera from "@/components/layout/Cabecera.astro";
import PiePagina from "@/components/layout/PiePagina.astro";
import CajonCarrito from "@/features/carrito/CajonCarrito";
import ModalBuscador from "@/features/busqueda/ModalBuscador";
import CajonMovil from "@/components/layout/CajonMovil";
import "@/styles/global.css";

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;
  rutaActual?: string;
  generoActual?: string;
  noIndexar?: boolean;
  // Aliases de retrocompatibilidad
  title?: string;
  description?: string;
  image?: string;
  currentPath?: string;
  currentGender?: string;
  noindex?: boolean;
}

const {
  titulo,
  title,
  descripcion,
  description,
  imagen,
  image,
  rutaActual,
  currentPath,
  generoActual,
  currentGender,
  noIndexar,
  noindex = false,
} = Astro.props;

const tituloFinal = titulo || title || "Maison des Parfums | Perfumería en Perú";
const descripcionFinal =
  descripcion ||
  description ||
  "Perfumería premium con fragancias para hombre, mujer y unisex. Atención y pedidos personalizados por WhatsApp.";
const imagenFinal = imagen || image || "/assets/maison-logo.jpeg";
const bloquearIndexacion = noIndexar !== undefined ? noIndexar : noindex;

const urlCanonica = new URL(Astro.url.pathname, Astro.site || "https://maison.pe");
const urlImagenResuelta = new URL(imagenFinal, Astro.site || "https://maison.pe").toString();
const rutaActiva = rutaActual || currentPath || Astro.url.pathname;
const generoActivo = generoActual || currentGender;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{tituloFinal}</title>
    <meta name="description" content={descripcionFinal} />
    <link rel="canonical" href={urlCanonica} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {bloquearIndexacion && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph / WhatsApp / Redes Sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:title" content={tituloFinal} />
    <meta property="og:description" content={descripcionFinal} />
    <meta property="og:image" content={urlImagenResuelta} />
    <meta property="og:locale" content="es_PE" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloFinal} />
    <meta name="twitter:description" content={descripcionFinal} />
    <meta name="twitter:image" content={urlImagenResuelta} />

    <slot name="head" />
  </head>
  <body>
    <div class="app-shell">
      <BarraAnuncio />
      <Cabecera rutaActual={rutaActiva} generoActual={generoActivo} />

      <slot />

      <PiePagina />

      <!-- Islas React reactivas globales -->
      <CajonCarrito client:idle />
      <ModalBuscador client:idle />
      <CajonMovil client:idle />
    </div>
  </body>
</html>
