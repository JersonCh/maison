---
import { normalizarTelefonoWhatsApp } from "@/features/whatsapp/whatsapp";
import Icon from "@/components/ui/Icon";

interface Props {
    whatsapp?: string;
    instagram?: string;
    facebook?: string;
    tiktok?: string;
    horario?: string;
}

const {
    whatsapp = "910292249",
    instagram = "https://instagram.com/maisondesparfums",
    facebook = "https://facebook.com/maisondesparfums",
    tiktok = "https://tiktok.com/@maisondesparfums",
    horario = "Lunes a sábado · 10:00 am - 8:00 pm",
} = Astro.props;

const phone = normalizarTelefonoWhatsApp(whatsapp);
const whatsappUrl = `https://wa.me/${phone}?text=${encodeURIComponent("Hola Maison des Parfums, deseo realizar una consulta.")}`;

const formatSocialUrl = (url?: string, defaultBase = "") => {
    if (!url) return "#";
    const clean = url.trim();
    if (clean.startsWith("http://") || clean.startsWith("https://"))
        return clean;
    return `${defaultBase}${clean.replace(/^@/, "")}`;
};

const instagramUrl = formatSocialUrl(instagram, "https://instagram.com/");
const facebookUrl = formatSocialUrl(facebook, "https://facebook.com/");
const tiktokUrl = formatSocialUrl(tiktok, "https://tiktok.com/@");
---

<footer>
    <div class="footer-main">
        <div class="footer-brand">
            <img src="/assets/logo-no-fondo300.png" alt="Maison des Parfums" />
            <p>
                Fragancias originales seleccionadas para convertir cada
                presencia en un recuerdo.
            </p>
            <div class="socials">
                <a
                    href={instagramUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Instagram"
                >
                    <Icon name="instagram" size={15} />
                </a>
                <a
                    href={facebookUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Facebook"
                >
                    <Icon name="facebook" size={15} />
                </a>
                <a
                    href={tiktokUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="TikTok"
                >
                    <Icon name="tiktok" size={15} />
                </a>
            </div>
        </div>

        <div>
            <h3>Explora</h3>
            <a href="/perfumes">Todos los perfumes</a>
            <a href="/perfumes?genero=Hombre">Hombre</a>
            <a href="/perfumes?genero=Mujer">Mujer</a>
            <a href="/perfumes?genero=Unisex">Unisex</a>
        </div>

        <div>
            <h3>Maison</h3>
            <a href="/nosotros">Nosotros</a>
            <a href="/contacto">Contacto</a>
            <a href="/faq">Preguntas frecuentes</a>
            <a href="/admin">Administración</a>
        </div>

        <div>
            <h3>Atención</h3>
            <p>
                <a
                    href={whatsappUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="footer-wa-link"
                >
                    <Icon name="whatsapp" size={16} /> Escríbenos por WhatsApp ↗
                </a>
            </p>
            <p>{horario}</p>
            <p>Perú</p>
        </div>
    </div>

    <div class="footer-bottom">
        <span>© 2026 Maison des Parfums</span>
        <span>Experiencia de compra por WhatsApp</span>
    </div>
</footer>
