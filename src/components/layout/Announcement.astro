---
interface Props {
  text?: string;
}

const {
  text = "🚚 Despachos los jueves a todo el Perú por Shalom y Olva Courier · Fragancias 100% originales",
} = Astro.props;

const parts = text.split(" · ");
---

<div class="announcement" role="region" aria-label="Aviso importante">
  {parts.map((part, index) => (
    <Fragment key={index}>
      <span class="announcement-item">{part}</span>
      {index < parts.length - 1 && <span class="announcement-dot" aria-hidden="true"></span>}
    </Fragment>
  ))}
</div>
