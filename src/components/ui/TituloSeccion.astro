---
interface Props {
  eyebrow?: string;
  antetitulo?: string;
  title?: string;
  titulo?: string;
  copy?: string;
  descripcion?: string;
  light?: boolean;
  claro?: boolean;
  class?: string;
  clase?: string;
}

const {
  eyebrow,
  antetitulo,
  title,
  titulo,
  copy,
  descripcion,
  light,
  claro = false,
  class: className = "",
  clase = "",
} = Astro.props;

const textoAntetitulo = antetitulo || eyebrow || "";
const textoTitulo = titulo || title || "";
const textoDescripcion = descripcion || copy;
const esClaro = light !== undefined ? light : claro;
---

<div class={`section-title ${esClaro ? "light" : ""} ${className} ${clase}`.trim()}>
  <span>{textoAntetitulo}</span>
  <h2>{textoTitulo}</h2>
  {textoDescripcion && <p>{textoDescripcion}</p>}
</div>
