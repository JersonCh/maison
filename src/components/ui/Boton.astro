---
interface Props {
  variant?: "gold" | "dark" | "outline" | "ghost";
  variante?: "oro" | "oscuro" | "borde" | "fantasma" | "gold" | "dark" | "outline" | "ghost";
  type?: "button" | "submit";
  tipo?: "button" | "submit";
  href?: string;
  enlace?: string;
  class?: string;
  clase?: string;
  id?: string;
  disabled?: boolean;
  deshabilitado?: boolean;
  target?: string;
  rel?: string;
  "aria-label"?: string;
}

const {
  variant,
  variante = "gold",
  type,
  tipo = "button",
  href,
  enlace,
  class: className = "",
  clase = "",
  id,
  disabled,
  deshabilitado = false,
  target,
  rel,
  "aria-label": ariaLabel,
} = Astro.props;

// Normalizar variante
const varianteSeleccionada = variant || variante;
const mapeoVariantes: Record<string, string> = {
  oro: "gold",
  oscuro: "dark",
  borde: "outline",
  fantasma: "ghost",
  gold: "gold",
  dark: "dark",
  outline: "outline",
  ghost: "ghost",
};
const claseVariante = mapeoVariantes[varianteSeleccionada] || "gold";

// Normalizar enlace, tipo y clases
const destino = href || enlace;
const tipoBoton = type || tipo;
const estaDeshabilitado = disabled !== undefined ? disabled : deshabilitado;
const clasesFinales = `btn btn-${claseVariante} ${className} ${clase}`.trim();
---

{
  destino ? (
    <a
      href={destino}
      id={id}
      class={clasesFinales}
      target={target}
      rel={rel}
      aria-label={ariaLabel}
    >
      <slot />
    </a>
  ) : (
    <button
      type={tipoBoton}
      id={id}
      class={clasesFinales}
      disabled={estaDeshabilitado}
      aria-label={ariaLabel}
    >
      <slot />
    </button>
  )
}
