{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maison-des-parfums",
  "compatibility_date": "2025-02-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maison-db",
      "database_id": "local-maison-db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "maison-assets"
    }
  ]
}
